# Copy to .env.local (not committed) to change a value. Every VITE_* variable is copied into
# the browser bundle: never put a secret here.

# Where the dev server forwards /api, /docs, /redoc and /openapi.json.
# Change the port here when you start the API with `orbispanora run --port <port>`.
VITE_DEV_API_TARGET=http://127.0.0.1:8000

# Origin of the API as the browser sees it. Leave empty for the same origin as the page,
# which is what the dev proxy and a reverse proxy both provide.
# VITE_API_BASE_URL=

# Largest world archive (MiB) the upload form accepts. The API's own limit is 500.
# VITE_MAX_UPLOAD_MB=500

# Minecraft version whose client.jar the block sprites are drawn from. The browser downloads about
# 5 MB of it from Mojang once and keeps the result. Use a version id of Mojang's version manifest.
# VITE_MINECRAFT_VERSION=26.3
