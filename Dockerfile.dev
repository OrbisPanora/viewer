# Development image: runs the Vite dev server with hot reload.
FROM node:24-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 5173

# The dev server listens on loopback by default; inside a container it must listen on all
# interfaces for the published port to work. Polling is needed for file changes to be seen
# through a bind mount on some hosts.
ENV CHOKIDAR_USEPOLLING=true
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
