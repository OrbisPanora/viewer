{
  "name": "orbispanora-web",
  "version": "0.1.0",
  "private": true,
  "description": "Isometric Minecraft world viewer for the OrbisPanora API",
  "license": "LicenseRef-PolyForm-Noncommercial-1.0.0",
  "homepage": "https://github.com/OrbisPanora/viewer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrbisPanora/viewer.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@pixi/tilemap": "^5.0.2",
    "pinia": "^4.1.0",
    "pixi.js": "^8.22.0",
    "vue": "^3.5.44",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.1",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.65.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
